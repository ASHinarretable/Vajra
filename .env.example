# Copy to .env and adjust as needed. Defaults work for local `docker compose up`.

# --- Kafka ---
# Inside the docker network, services reach Kafka at kafka:29092.
# From your host machine (scripts, notebooks) use localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
TOPIC_RAW=transactions.raw
TOPIC_CLEANED=transactions.cleaned
TOPIC_SUSPICIOUS=transactions.suspicious

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vajra
POSTGRES_USER=vajra
POSTGRES_PASSWORD=vajra

# --- Producer ---
# Transactions per second to emit.
PRODUCER_RATE=5
# Probability (0-1) that a given emission is steered into a fraud scenario.
FRAUD_RATE=0.08
# Number of simulated UPI users.
NUM_USERS=200

# --- Consumer ---
CONSUMER_GROUP=vajra-fraud-consumer

# --- Airflow ---
# Generate your own for any non-local deployment:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=sDGsj4K7imH65S4GsridqaRAko1ZOUD4v12MkAXdBZg=
AIRFLOW_SECRET_KEY=vajra-local-dev-secret
